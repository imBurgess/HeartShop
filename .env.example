# ================================================
# HeartShop 統一環境設定範本
# 複製此檔案為 .env，並修改為你的本機設定
# AWS 部署時由 ECS Task Definition / Parameter Store 注入，不需此檔案
# ================================================

# --- 後端資料庫連線 ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=heartshop
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# --- JWT 密鑰（正式環境請換成高強度隨機字串） ---
JWT_SECRET=HeartShop-Super-Secret-Key-For-Development-Environment-Change-This-In-Production-64Bytes

# --- API 伺服器地址（前端使用，不含 /api 路徑） ---
VITE_API_BASE_URL=http://localhost:8080
